# Build artifacts
build/
build_*/

# Intermediate build scratch — never committed
GHReleases/
baked/
prebuilt/
cattobaked/

# releases/ IS tracked — distributable flash.bin artifacts per version

# Scratch build workspace
tmp/

# purrstrap device config (local paths/ports)
.purrstrap
CoreOS/build/
CoreOS/build_*/
CoreOS/sdkconfig
CoreOS/sdkconfig.old
CoreOS/dependencies.lock
# Device sdkconfig_* source files ARE tracked — only ignore IDF-generated sdkconfig

# IDF managed components — fetched at build time, not stored in VCS
CoreOS/managed_components/

# SDK config (contains local paths/ports, not for VCS)
Builder/purr_build.cfg
Builder/purr_sdk.cfg
SDK/purr_sdk.cfg

# Root-level scratch files (anchored to repo root only)
/CMakeLists.txt
/main.cpp
/purr_api.h

# Python
__pycache__/
*.pyc
*.pyo

# Local virtualenv for the asset converters (source/assets/icons/convert_icons.py
# and wallpapers/convert_wallpaper.py). Host-specific and rebuildable — see
# convert_icons.py's header for the exact package set, including the Windows
# svglib/pycairo path and the cairocffi trap.
.iconvenv/

# VSCode
.vscode/

# OS
.DS_Store
Thumbs.db
.claude/
signing_keys/
