# modules/server_mgr/module.pcat
# Server Manager wire protocol — remote WiFi config + chunked app transfer/
# approval, riding on proximity_rpc.h the same way pairing.h's own USERAUTH/
# OOBE actions do. See server_mgr.h for the full design.

name              = "server_mgr"
version           = "1.0.0"
module_type       = "PURR_MOD_SYSTEM"
kernel_min        = "0.11.1"
kernel_max        = ""

provides          = ["server_manager_protocol"]
required_catcalls = []
