# CoreOS profile: full (the normal system)
CONFIG_PURR_PROFILE_FULL=y

# The main task stack: the default is 32 KB (sdkconfig.defaults) because a TLS download on this task overflowed 16 KB on the real device (2026-10-03). The full system
# measured 26 KB of its 33 KB never used in normal use (Task Manager, owner, 2026-11-05), and a download now runs on a PSRAM-stack worker (purr_fetch.c), so the main
# task keeps 16 KB: 16 KB of fast RAM given back. If a fetch cannot get its PSRAM stack it falls back to the caller's, and a serial `netinstall` could overflow this.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Pictures for apps (the ui catcall's image widget, 1.0.23): JPEG, PNG and BMP decoders, a monospace face for the terminal, and a decoded-image cache in PSRAM (LVGL
# decodes on every redraw without one). Only the full system draws app pictures: KittenOS and the loader do not carry this, because the loader writes KittenOS into a
# 1.5 MB slot and with these it was 11 KB too big (2026-11-05: "something went wrong while installing KittenOS").
CONFIG_LV_USE_TJPGD=y
CONFIG_LV_USE_LODEPNG=y
CONFIG_LV_USE_BMP=y
CONFIG_LV_FONT_UNSCII_16=y
CONFIG_LV_CACHE_DEF_SIZE=4194304


# Internal RAM, second pass (2026-11-05): the T-Deck Plus board file keeps allocations under 4 KB in fast RAM; the full system takes that down to 256 bytes, so nearly
# everything the OS allocates without asking for a kind of memory lands in PSRAM (DMA, stacks and Wi-Fi ask for their own kind and still get internal), and Wi-Fi may
# queue 16 packets each way instead of 32 (each is about 1.6 KB of fast RAM while traffic is queued). Only the full kernel carries this: KittenOS and the loader, the
# recovery path, keep the board file's values. To undo, delete these three lines. A smaller device later lowers the threshold further or sets it to 0.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
