menu "PURR OS"

    choice PURR_BOARD
        prompt "Board"
        default PURR_BOARD_TDECK_PLUS
        help
            The board profile compiled in (pins, buses and devices). Only the
            kernel reads this.

        config PURR_BOARD_TDECK
            bool "LilyGO T-Deck (BlackDeck)"

        config PURR_BOARD_TDECK_PLUS
            bool "LilyGO T-Deck Plus (BlackDeck+)"

        config PURR_BOARD_CYD_24C
            bool "CYD 2.4C (ESP32-2432S024C)"

        config PURR_BOARD_WAVESHARE154
            bool "Waveshare ESP32-S3-ePaper-1.54"

        config PURR_BOARD_PLAYTIME
            bool "Playtime (ESP32-S3, 320x240 ST7789V, gamepad module, no touch)"
    endchoice

    # The boards with the colour LCD and enough flash for the LVGL shell. The UI, the setup wizard and the recovery app are built for these.
    config PURR_BOARD_COLOR_LCD
        bool
        default y if PURR_BOARD_TDECK || PURR_BOARD_TDECK_PLUS || PURR_BOARD_PLAYTIME

endmenu
