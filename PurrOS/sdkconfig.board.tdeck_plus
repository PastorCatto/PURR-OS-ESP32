# T-Deck Plus: ESP32-S3, 16 MB quad flash, 8 MB PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/tdeck_plus.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions/tdeck_plus.csv"
CONFIG_PURR_BOARD_TDECK_PLUS=y

# The N16R8 module's PSRAM is Octal SPI. Needed for the recovery loader, which downloads
# a KittenOS image into PSRAM before verifying and writing it (RecoveryLoader/SPEC.md).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
