menu "PURR OS profile"

    choice PURR_PROFILE
        prompt "CoreOS profile"
        default PURR_PROFILE_FULL
        help
            What this build is. Set by the sdkconfig.profile.<name> file that purrstrap passes.

        config PURR_PROFILE_FULL
            bool "full: the normal system"

        config PURR_PROFILE_RECOVERY
            bool "recovery: KittenOS"

        config PURR_PROFILE_MINIMAL
            bool "minimal: the recovery loader"
    endchoice

    config PURR_RECOVERY_MANIFEST_URL
        string "Recovery manifest URL"
        default "https://github.com/PastorCatto/PURR-OS-ESP32/releases/download/INTERN/recovery.manifest"
        help
            Where the recovery manifest (OTA/SPEC.md section 5) is fetched from, over HTTPS.
            The recovery loader (minimal profile) uses this on its own for KittenOS; KittenOS
            itself (recovery profile) uses it for the shell's "net install" (Install/SPEC.md),
            which installs PURR OS. Named images are fetched from the same URL's directory.
            Set this to a real release's manifest before building for a device that needs to
            recover or install over the internet.

endmenu
