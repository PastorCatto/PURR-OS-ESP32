# Waveshare ESP32-S3-ePaper-1.54: ESP32-S3-PICO-1-N8R8, 8 MB flash, 8 MB PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/waveshare154.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions/waveshare154.csv"
CONFIG_PURR_BOARD_WAVESHARE154=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
