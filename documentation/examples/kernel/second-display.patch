--- a/PurrOS/components/kernel/src/purr_gfx.c
+++ b/PurrOS/components/kernel/src/purr_gfx.c
@@ -52,3 +52,51 @@
     free(buf);
     return e;
 }
+
+/* ---------------------------------------------------------------- tee (mirror) display */
+
+static const purr_display_v2_t *s_tee_a, *s_tee_b;
+
+static esp_err_t tee_get_info(purr_display_info_t *out)
+{
+    return s_tee_a->get_info(out);
+}
+
+static esp_err_t tee_blit(int x, int y, int w, int h, const uint16_t *px)
+{
+    esp_err_t ea = s_tee_a->blit(x, y, w, h, px);
+    esp_err_t eb = s_tee_b->blit(x, y, w, h, px);
+    return ea != ESP_OK ? ea : eb;
+}
+
+static esp_err_t tee_fill(int x, int y, int w, int h, uint16_t color)
+{
+    esp_err_t ea = s_tee_a->fill(x, y, w, h, color);
+    esp_err_t eb = s_tee_b->fill(x, y, w, h, color);
+    return ea != ESP_OK ? ea : eb;
+}
+
+static purr_display_v2_t s_tee_ops = {
+    .struct_size = sizeof(purr_display_v2_t),
+    .major = PURR_DISPLAY_MAJOR,
+    .minor = PURR_DISPLAY_MINOR,
+    .features = 0,                       /* no optional functions: brightness is per panel */
+    .get_info = tee_get_info,
+    .blit = tee_blit,
+    .fill = tee_fill,
+};
+
+const purr_display_v2_t *purr_display_tee(const purr_display_v2_t *a, const purr_display_v2_t *b)
+{
+    if (a == NULL || b == NULL) {
+        return NULL;
+    }
+    purr_display_info_t ia, ib;
+    if (a->get_info(&ia) != ESP_OK || b->get_info(&ib) != ESP_OK ||
+        ia.width != ib.width || ia.height != ib.height) {
+        return NULL;
+    }
+    s_tee_a = a;
+    s_tee_b = b;
+    return &s_tee_ops;
+}
