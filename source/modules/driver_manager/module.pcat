# modules/driver_manager/module.pcat
#
# STATUS (2026-09): the flash/SD .purr scan + validate + compat-check
# pipeline this module was designed around is disabled — see
# driver_manager.c's own top comment for why it could never load a real
# out-of-tree object in the first place. Every driver on every device
# loads via static registration from device.pcat instead. This module
# stays registered (kept for the drv_entry_t/drv_status_t API shape a
# real loadable-driver mechanism, built on claw_loader, should grow back
# into) but currently exposes an always-empty registry to the UI.

name            = "driver_manager"
version         = "0.1.0"
module_type     = "PURR_MOD_SYSTEM"
kernel_min      = "0.9.0"
kernel_max      = ""

provides        = ["driver_registry"]
required_catcalls = []   # no catcall deps — it manages catcall registration

# Runtime status badges exposed to UI (kept for API-shape continuity;
# always empty today — see this file's own top comment):
#   [OK]     — within kernel_min/max, all catcalls validated
#   [COMPAT] — beyond kernel_max, all required_catcalls still present
#   [FAIL]   — required_catcall missing, driver did not load
