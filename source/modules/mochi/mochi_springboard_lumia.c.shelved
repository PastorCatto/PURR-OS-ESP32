// mochi_springboard_lumia.c.shelved — SHELVED, 2026-09-02. Not compiled: not
// listed in source/modules/mochi/CMakeLists.txt's MOCHI_SRCS, and the
// `.shelved` extension (not `.c`) keeps it out of any glob too. Built, it
// worked (clean build, clean boot, no crashes — confirmed live on real
// tdeck_plus hardware) but was set aside in favour of the original iOS-style
// squircle grid this file replaced, which source/modules/mochi/
// mochi_springboard.c has been reverted back to (`git checkout` from the
// last commit — this Lumia version was never committed).
//
// To bring it back: overwrite mochi_springboard.c with this file's content
// (minus this header block) and add `mochi_springboard.c` back to
// CMakeLists.txt's MOCHI_SRCS (it's already there — this file just needs to
// replace it). Everything below this point is otherwise unchanged from what
// actually ran on hardware.
//
// mochi_springboard.c — the Windows-Phone/Lumia-style "Live Tiles" home
// screen.
//
// ── Why this looks the way it does ──────────────────────────────────────────
// 2026-09-01: replaced the original iOS-style paged squircle grid with a
// Lumia-style Live Tiles layout, ported from fbiego's Lumia-ESP32 (MIT,
// SquareLine Studio + LVGL 8.2 — same LVGL version this codebase already
// uses). Real source was read directly (ui.c/ui.h/main.cpp/main.h, plus its
// own reference screenshots), not guessed from description — see this
// session's own plan doc for the full trail. Two things that source project
// does NOT have, and this port deliberately does not invent: real image
// assets (its icons are raw LVGL arrays that risk a silent colour-depth
// mismatch against this project's own LVGL config — reused this codebase's
// OWN existing icon set instead, see mochi_icon_for_app() below, unchanged)
// and real authentication (its own passcode struct is loaded/saved via NVS
// but never once verified anywhere in its source — this backend's actual
// login remains systemui_login_ios.c's real user_mgr_verify() flow,
// untouched by this file).
//
// Portrait 320x480 (Lumia's own target) does not transfer directly onto this
// device's 320x240 landscape panel — every dimension below is re-derived for
// this shape, not copied. Screen layout:
//
//   ┌────────────────────────────────────────┐
//   │ status bar (systemui, lv_layer_top)    │  PURR_SYSTEMUI_STATUS_H
//   │ ┌────────┐ ┌──────────────┐ ┌────────┐ │
//   │ │  tile  │ │  wide tile   │ │  tile  │ │  Live Tiles: solid colour
//   │ │ Term   │ │    Settings  │ │ Files  │ │  (mochi_color_for_app()),
//   │ └────────┘ └──────────────┘ └────────┘ │  white icon + label, mixed
//   │ ┌────────┐ ┌────────┐ ┌────────┐       │  1-wide/2-wide, scrolls
//   │ │  tile  │ │  tile  │ │  tile  │  ...   │  vertically (no paging/dock
//   │ └────────┘ └────────┘ └────────┘       │  — Lumia has neither).
//   │ ← back        ⊞ home         🔍 search │  bottom bar, 3 buttons
//   └────────────────────────────────────────┘  (lv_layer_top, persists
//                                                 over app windows)
//
// A vertical swipe-down from anywhere on the tile screen (not the very top
// status-bar strip, which stays systemui's own drag zone) opens a real,
// scoped quick-settings panel — see the "Quick settings" section below for
// exactly what's real vs. deliberately left out.
//
// ── Selection model ─────────────────────────────────────────────────────────
// Tiles are laid out left-to-right, top-to-bottom, greedy-packed (a 2-wide
// tile that doesn't fit the remaining columns in its row starts the next row
// instead). Each tile's (row, col, span) is recorded at layout time
// (s_tile_row/_col/_span), so trackball/keyboard navigation can find "the
// tile above/below" by nearest column rather than assuming a uniform grid —
// unlike the old paged grid, a Live Tiles layout is not one.

#include "mochi.h"
#include "../systemui/systemui.h"
#include "../../assets/icons/blackpurr_icons.h"
#include "../../kernel/core/purr_kernel.h"
#include "../../kernel/catcalls/purr_win.h"
#include "../app_manager/app_manager.h"
#include "esp_log.h"
#include <stdio.h>
#include <string.h>
#include <ctype.h>

// Built-in wallpaper, generated by source/assets/wallpapers/convert_wallpaper.py
// (--c-array) and compiled in via this component's CMakeLists. Declared here
// rather than in a header because it is one symbol with exactly one consumer
// (the systemui host hook below — Lumia's own home screen is a plain black
// canvas, not a wallpaper photo, see home.png; the wallpaper still exists for
// whatever systemui surface wants one, e.g. the shared idle-lock screen).
extern const lv_img_dsc_t purr_wallpaper;

static const lv_img_dsc_t *mochi_wallpaper(void) { return &purr_wallpaper; }

static const char *TAG = "mochi_sb";

// ── Lumia palette ────────────────────────────────────────────────────────────
// Black canvas, white text — Windows Phone's whole visual identity before any
// layout is considered. COL_ACCENT is deliberately kept for focus rings/
// selection only, not tile fills: real Live Tiles are each their own
// saturated colour (mochi_color_for_app(), unchanged below), not one theme
// colour repeated — matching what home.png actually shows (varied blue/
// green/orange/... tiles), not a single-accent look.
#define COL_BG          lv_color_hex(0x000000)
#define COL_LABEL       lv_color_hex(0xFFFFFF)
#define COL_LABEL_2     lv_color_hex(0xB0B0B0)
#define COL_ACCENT      lv_color_hex(0x00A2E8)   // Lumia's own cyan-blue accent
#define COL_PANEL       lv_color_hex(0x1C1C1C)   // quick-settings panel ground
#define COL_TOGGLE_ON   lv_color_hex(0x00A2E8)
#define COL_TOGGLE_OFF  lv_color_hex(0x3A3A3A)

// ── Tile geometry, derived from the real panel ──────────────────────────────
// Same discipline the original grid used: nothing here is hardcoded to
// 320x240 specifically, so a differently-sized LVGL device still lays out
// sanely (see compute_metrics()).
#define TILE_GUTTER      4
#define TILE_ICON_SIZE   28
#define MAX_COLS         6
#define MAX_TILES        64
#define BOTTOM_BAR_H     28

// Live values, set by compute_metrics(). Defaults match this device's own
// 320x240 so a panel whose get_info() fails still builds a sane layout.
static int       s_cols     = 3;
static lv_coord_t s_col_w   = 100;
static lv_coord_t s_row_h   = 88;
static lv_coord_t s_grid_y  = 22;
static lv_coord_t s_grid_bottom = 212;

// ── State ───────────────────────────────────────────────────────────────────

static int s_tile_count = 0;
static int s_sel         = 0;   // index into the flat, layout-order tile list

static lv_obj_t *s_screen;
static lv_obj_t *s_tile_scroll;                 // scrollable container holding all tiles
static lv_obj_t *s_tile_cells[MAX_TILES];        // the tile object itself, for selection styling
static int       s_tile_app[MAX_TILES];          // registry index backing each tile
static int8_t     s_tile_row[MAX_TILES];
static int8_t     s_tile_col[MAX_TILES];
static int8_t     s_tile_span[MAX_TILES];         // 1 or 2 columns wide

// Same touch-vs-cursor visibility rule the original grid used — see its own
// comment, unchanged reasoning.
static bool s_cursor_visible = false;

static void attach_touch_handlers(lv_obj_t *obj);

static uint32_t hash_str(const char *s)
{
    uint32_t h = 2166136261u; // FNV-1a
    while (*s) { h ^= (uint8_t)*s++; h *= 16777619u; }
    return h;
}

// Deterministic per-app icon colour — unchanged from the original iOS grid.
// Doubles here as Live Tile fill colour, which is exactly the right amount
// of reuse: a real Lumia home screen is nothing but solid-colour rectangles,
// so the palette that made sense for a squircle icon tint makes just as much
// sense as a whole tile's background.
lv_color_t mochi_color_for_app(const char *name)
{
    static const uint32_t palette[] = {
        0x007AFF, // blue
        0x34C759, // green
        0xFF9500, // orange
        0xFF3B30, // red
        0xAF52DE, // purple
        0x5AC8FA, // teal
        0xFFCC00, // yellow
        0xFF2D55, // pink
        0x5856D6, // indigo
    };
    return lv_color_hex(palette[hash_str(name) % (sizeof(palette) / sizeof(palette[0]))]);
}

// The system icon set — unchanged from the original. See mochi.h for why the
// launcher owns it, and this file's own header comment for why Lumia's own
// image assets were not imported (colour-depth mismatch risk for zero gain,
// since this set already exists and already covers every registered app).
const lv_img_dsc_t *mochi_icon_for_app(const char *name)
{
    static const struct { const char *app_name; const lv_img_dsc_t *icon; } map[] = {
        { "settings",   &bp_icon_settings_48   },
        { "about",      &bp_icon_about_48      },
        { "terminal",   &bp_icon_terminal_48   },
        { "fileman",    &bp_icon_fileman_48    },
        { "calculator", &bp_icon_calculator_48 },
        { "diagnostics", &bp_icon_taskmgr_48   },
        { "milkbar",    &bp_icon_milkbar_48    },
        { "msn",        &bp_icon_msn_48        },
        { "meshchat",   &bp_icon_messages_48   },
        { "magicmac",   &bp_icon_magicmac_48   },
        { "magidos",    &bp_icon_magidos_48    },
    };
    if (!name) return &bp_icon_tools_48;
    for (size_t i = 0; i < sizeof(map) / sizeof(map[0]); i++) {
        if (strcmp(name, map[i].app_name) == 0) return map[i].icon;
    }
    return &bp_icon_tools_48;
}

// ── Geometry ─────────────────────────────────────────────────────────────────

static void compute_metrics(uint16_t w, uint16_t h)
{
    const lv_coord_t top = PURR_SYSTEMUI_STATUS_H;

    // 3 columns reproduces Lumia's own 2-column-at-320-portrait density on
    // this device's wider landscape panel (landscape has the width to
    // spare) — same "derive from real size" discipline the original grid
    // used, just re-targeted: this device's panel is what's actually being
    // laid out for, not a guess at what might look right.
    s_cols = (int)(w / 100);
    if (s_cols < 2) s_cols = 2;
    if (s_cols > MAX_COLS) s_cols = MAX_COLS;
    s_col_w = (lv_coord_t)(w / s_cols);

    s_grid_y = (lv_coord_t)(top);
    s_grid_bottom = (lv_coord_t)(h - BOTTOM_BAR_H);

    // Row height sized so two rows are visible at once on a 240px panel
    // before scrolling — tall enough for a real icon + label, short enough
    // that the list reads as tiles, not tall cards.
    s_row_h = (lv_coord_t)((s_grid_bottom - s_grid_y) / 2);
    if (s_row_h < TILE_ICON_SIZE + 24) s_row_h = (lv_coord_t)(TILE_ICON_SIZE + 24);

    ESP_LOGI(TAG, "tiles: %d cols, cell %dx%d, grid y=%d..%d on %ux%u",
             s_cols, (int)s_col_w, (int)s_row_h, (int)s_grid_y, (int)s_grid_bottom, w, h);
}

// ── Layout ───────────────────────────────────────────────────────────────────
// Greedy left-to-right, top-to-bottom packing. Roughly 1 in 3 apps gets a
// 2-wide tile — a fixed ratio, not per-app metadata (app_manager has no
// "tile size" concept and inventing one here would be state this backend
// has no business owning, same reasoning the original file gave for not
// inventing a favourites concept) — enough to read as genuinely Live-Tile-
// like rather than a uniform grid pretending to be one.
static void compute_layout(void)
{
    s_tile_count = app_manager_count();
    if (s_tile_count > MAX_TILES) s_tile_count = MAX_TILES;

    int col = 0, row = 0;
    for (int i = 0; i < s_tile_count; i++) {
        const app_entry_t *app = app_manager_get(i);
        int span = 1;
        if (app && s_cols > 1 && (hash_str(app->name) % 3) == 0) span = 2;
        if (span > s_cols) span = s_cols;

        if (col + span > s_cols) { col = 0; row++; }

        s_tile_row[i]  = (int8_t)row;
        s_tile_col[i]  = (int8_t)col;
        s_tile_span[i] = (int8_t)span;

        col += span;
        if (col >= s_cols) { col = 0; row++; }
    }
    if (s_sel >= s_tile_count) s_sel = s_tile_count > 0 ? s_tile_count - 1 : 0;
}

// ── Rendering ───────────────────────────────────────────────────────────────

static void cell_click_cb(lv_event_t *e);
static void launch_app(int registry_idx);

static void apply_selection_style(lv_obj_t *obj, bool selected)
{
    if (!obj) return;
    lv_obj_set_style_outline_width(obj, selected ? 3 : 0, 0);
    lv_obj_set_style_outline_color(obj, COL_ACCENT, 0);
    lv_obj_set_style_outline_pad(obj, selected ? 2 : 0, 0);
    lv_obj_set_style_outline_opa(obj, selected ? LV_OPA_COVER : LV_OPA_TRANSP, 0);
}

static void render_selection(void)
{
    for (int i = 0; i < s_tile_count; i++) {
        apply_selection_style(s_tile_cells[i], s_cursor_visible && i == s_sel);
    }
    if (s_cursor_visible && s_tile_cells[s_sel]) {
        lv_obj_scroll_to_view(s_tile_cells[s_sel], LV_ANIM_ON);
    }
}

// Builds one Live Tile: solid colour fill, white icon upper-left-ish, white
// label bottom-left (Lumia's own label position — distinct from the
// original iOS grid's centred-under-icon caption).
static lv_obj_t *build_tile(lv_obj_t *parent, int registry_idx, int tile_idx)
{
    const app_entry_t *app = app_manager_get(registry_idx);
    if (!app) return NULL;

    lv_coord_t x = (lv_coord_t)(s_tile_col[tile_idx] * s_col_w);
    lv_coord_t y = (lv_coord_t)(s_tile_row[tile_idx] * s_row_h);
    lv_coord_t tw = (lv_coord_t)(s_tile_span[tile_idx] * s_col_w - TILE_GUTTER);
    lv_coord_t th = (lv_coord_t)(s_row_h - TILE_GUTTER);

    lv_obj_t *tile = lv_obj_create(parent);
    lv_obj_remove_style_all(tile);
    lv_obj_set_size(tile, tw, th);
    lv_obj_set_pos(tile, x, y);
    lv_obj_set_style_radius(tile, 0, 0);   // Lumia tiles are square-cornered, not squircles
    lv_obj_set_style_bg_color(tile, mochi_color_for_app(app->name), 0);
    lv_obj_set_style_bg_opa(tile, LV_OPA_COVER, 0);
    lv_obj_clear_flag(tile, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_add_flag(tile, LV_OBJ_FLAG_CLICKABLE);
    lv_obj_add_event_cb(tile, cell_click_cb, LV_EVENT_CLICKED, (void *)(intptr_t)tile_idx);
    attach_touch_handlers(tile);

    lv_obj_t *glyph = lv_img_create(tile);
    lv_img_set_src(glyph, mochi_icon_for_app(app->name));
    lv_img_set_zoom(glyph, (uint16_t)((TILE_ICON_SIZE * 256) / 48));
    // White glyph regardless of the source icon's own recolour — Live Tiles
    // are always white-on-colour, never the icon's "natural" tint.
    lv_obj_set_style_img_recolor(glyph, lv_color_white(), 0);
    lv_obj_set_style_img_recolor_opa(glyph, LV_OPA_COVER, 0);
    lv_obj_set_pos(glyph, 8, 8);
    lv_obj_clear_flag(glyph, LV_OBJ_FLAG_CLICKABLE);

    lv_obj_t *lbl = lv_label_create(tile);
    lv_label_set_text(lbl, app->name);
    lv_label_set_long_mode(lbl, LV_LABEL_LONG_DOT);
    lv_obj_set_width(lbl, (lv_coord_t)(tw - 12));
    lv_obj_set_style_text_color(lbl, COL_LABEL, 0);
    lv_obj_set_style_text_font(lbl, &lv_font_montserrat_14, 0);
    lv_obj_align(lbl, LV_ALIGN_BOTTOM_LEFT, 6, -6);
    lv_obj_clear_flag(lbl, LV_OBJ_FLAG_CLICKABLE);

    // Running-app dot, same convention the original grid used, top-right
    // corner here (bottom is already the label's).
    if (app->state == APP_STATE_RUNNING) {
        lv_obj_t *dot = lv_obj_create(tile);
        lv_obj_remove_style_all(dot);
        lv_obj_set_size(dot, 6, 6);
        purr_fx_radius(dot, LV_RADIUS_CIRCLE);
        lv_obj_set_style_bg_color(dot, lv_color_white(), 0);
        lv_obj_set_style_bg_opa(dot, LV_OPA_COVER, 0);
        lv_obj_align(dot, LV_ALIGN_TOP_RIGHT, -6, 6);
        lv_obj_clear_flag(dot, LV_OBJ_FLAG_CLICKABLE);
    }

    return tile;
}

// Rebuilds the whole tile list. Only called on layout change (registry
// change, resize) — never per tick, same discipline the original render_all()
// used.
static void render_tiles(void)
{
    if (!s_tile_scroll) return;
    lv_obj_clean(s_tile_scroll);
    memset(s_tile_cells, 0, sizeof(s_tile_cells));

    int max_row = 0;
    for (int i = 0; i < s_tile_count; i++) {
        s_tile_app[i] = i;
        s_tile_cells[i] = build_tile(s_tile_scroll, i, i);
        if (s_tile_row[i] > max_row) max_row = s_tile_row[i];
    }
    lv_obj_set_content_height(s_tile_scroll, (lv_coord_t)((max_row + 1) * s_row_h + TILE_GUTTER));

    render_selection();
}

// ── Bottom bar — back / home / search ───────────────────────────────────────
// Lumia's own three-button bar, replacing the iOS home-indicator pill this
// backend used to draw. Built on lv_layer_top() for the same reason the
// original home button was: that layer composites above lv_scr_act()'s
// whole tree, so the bar stays reachable while an app is full-screen.
static lv_obj_t *s_bar;
static lv_obj_t *s_apps_screen;   // the "all apps" list — see build_apps_screen()
static bool      s_apps_screen_open = false;

static void show_apps_screen(void);
static void hide_apps_screen(void);

static void back_btn_cb(lv_event_t *e)
{
    (void)e;
    if (s_apps_screen_open) { hide_apps_screen(); return; }
    mochi_win_hide_foreground();
}

static void home_btn_cb(lv_event_t *e)
{
    (void)e;
    if (s_apps_screen_open) { hide_apps_screen(); return; }
    if (purr_systemui_recents_open()) { purr_systemui_close_recents(); return; }
    mochi_win_hide_foreground();
}

static void search_btn_cb(lv_event_t *e)
{
    (void)e;
    if (s_apps_screen_open) hide_apps_screen();
    else                    show_apps_screen();
}

static lv_obj_t *build_bar_button(uint16_t w, uint16_t h, lv_coord_t x, const char *symbol,
                                   lv_event_cb_t cb)
{
    lv_obj_t *btn = lv_obj_create(s_bar);
    lv_obj_remove_style_all(btn);
    lv_obj_set_size(btn, (lv_coord_t)(w / 3), h);
    lv_obj_set_pos(btn, x, 0);
    lv_obj_set_style_bg_opa(btn, LV_OPA_TRANSP, 0);
    lv_obj_clear_flag(btn, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_add_flag(btn, LV_OBJ_FLAG_CLICKABLE);
    lv_obj_add_event_cb(btn, cb, LV_EVENT_CLICKED, NULL);

    lv_obj_t *glyph = lv_label_create(btn);
    lv_label_set_text(glyph, symbol);
    lv_obj_set_style_text_color(glyph, COL_LABEL, 0);
    lv_obj_center(glyph);
    lv_obj_clear_flag(glyph, LV_OBJ_FLAG_CLICKABLE);
    return btn;
}

static void build_bottom_bar(uint16_t w, uint16_t h)
{
    if (s_bar) return;   // built once; survives springboard rebuilds

    s_bar = lv_obj_create(lv_layer_top());
    lv_obj_remove_style_all(s_bar);
    lv_obj_set_size(s_bar, w, BOTTOM_BAR_H);
    lv_obj_set_pos(s_bar, 0, (lv_coord_t)(h - BOTTOM_BAR_H));
    lv_obj_set_style_bg_color(s_bar, COL_BG, 0);
    lv_obj_set_style_bg_opa(s_bar, LV_OPA_COVER, 0);
    lv_obj_clear_flag(s_bar, LV_OBJ_FLAG_SCROLLABLE);

    // LV_SYMBOL_SEARCH doesn't exist in this build's LVGL symbol font (a
    // curated subset, confirmed by reading lv_symbol_def.h directly rather
    // than assuming the usual full glyph set) — LV_SYMBOL_LIST (bars) is the
    // closest available stand-in for "open the all-apps list", not a literal
    // magnifying glass.
    build_bar_button(w, BOTTOM_BAR_H, 0,                          LV_SYMBOL_LEFT,   back_btn_cb);
    build_bar_button(w, BOTTOM_BAR_H, (lv_coord_t)(w / 3),        LV_SYMBOL_HOME,   home_btn_cb);
    build_bar_button(w, BOTTOM_BAR_H, (lv_coord_t)(2 * w / 3),    LV_SYMBOL_LIST,   search_btn_cb);
}

// ── Actions ─────────────────────────────────────────────────────────────────

static void launch_app(int registry_idx)
{
    const app_entry_t *app = app_manager_get(registry_idx);
    if (!app) return;
    ESP_LOGI(TAG, "launching '%s' (idx=%d)", app->name, registry_idx);
    if (app->state == APP_STATE_RUNNING && app->window) {
        purr_win_show(app->window);
    } else {
        app_manager_launch_idx(registry_idx);
    }
    purr_systemui_enter_app(registry_idx);
}

static void activate_selection(void)
{
    if (s_sel >= 0 && s_sel < s_tile_count) launch_app(s_tile_app[s_sel]);
}

// ── Touch / cursor ───────────────────────────────────────────────────────────

static bool  s_touch_down = false;
static bool  s_swiping    = false;
static lv_coord_t s_touch_x0, s_touch_y0;
#define SWIPE_MIN_PX 36

static void cell_click_cb(lv_event_t *e)
{
    if (s_swiping) { s_swiping = false; return; }
    int idx = (int)(intptr_t)lv_event_get_user_data(e);
    s_sel = idx;
    render_selection();
    activate_selection();
}

// Finds the tile in `target_row` whose column span is nearest the current
// tile's column — the "same-ish column" step a uniform grid gets for free,
// reconstructed here because a Live Tiles layout packs variable-width tiles
// and isn't one. Falls back to the row after, then gives up (no cursor move)
// if neither row has anything — a gap can legitimately happen at a page's
// ragged bottom edge.
static int find_in_row(int target_row, int want_col)
{
    int best = -1, best_dist = 10000;
    for (int i = 0; i < s_tile_count; i++) {
        if (s_tile_row[i] != target_row) continue;
        int dist = s_tile_col[i] > want_col ? s_tile_col[i] - want_col : want_col - s_tile_col[i];
        if (dist < best_dist) { best_dist = dist; best = i; }
    }
    return best;
}

static void move_cursor(int dcol, int drow)
{
    if (s_tile_count == 0) return;

    if (drow != 0) {
        int row = s_tile_row[s_sel] + drow;
        int want_col = s_tile_col[s_sel];
        int cand = find_in_row(row, want_col);
        if (cand < 0) cand = find_in_row(row + drow, want_col);   // skip one ragged/empty row
        if (cand >= 0) s_sel = cand;
        render_selection();
        return;
    }

    int next = s_sel + dcol;
    if (next < 0) next = 0;
    if (next >= s_tile_count) next = s_tile_count - 1;
    s_sel = next;
    render_selection();
}

static void sb_key_cb(lv_event_t *e)
{
    uint32_t key = lv_event_get_key(e);

    if (!s_cursor_visible) {
        s_cursor_visible = true;
        render_selection();
    }

    switch (key) {
        case LV_KEY_LEFT:  case LV_KEY_PREV: move_cursor(-1, 0); return;
        case LV_KEY_RIGHT: case LV_KEY_NEXT: move_cursor(+1, 0); return;
        case LV_KEY_UP:                       move_cursor(0, -1); return;
        case LV_KEY_DOWN:                     move_cursor(0, +1); return;
        case LV_KEY_ENTER:                    activate_selection(); return;
        case LV_KEY_ESC:                       if (s_apps_screen_open) hide_apps_screen(); return;
        default: break;
    }
}

// Touch: horizontal swipe is no longer paging (Lumia scrolls, doesn't page),
// so only a vertical down-swipe is tracked here, to open quick settings.
// Attached to the root AND to every tile, same reasoning the original grid's
// swipe handling gave — a gesture starting on a tile never reaches the root
// otherwise.
static void open_quick_settings(void);

static void sb_touch_cb(lv_event_t *e)
{
    lv_event_code_t code = lv_event_get_code(e);
    lv_indev_t *indev = lv_indev_get_act();
    if (!indev) return;
    if (lv_indev_get_type(indev) != LV_INDEV_TYPE_POINTER) return;

    lv_point_t pt;
    lv_indev_get_point(indev, &pt);

    if (code == LV_EVENT_PRESSED) {
        s_touch_x0 = pt.x;
        s_touch_y0 = pt.y;
        s_touch_down = true;
        if (s_cursor_visible) {
            s_cursor_visible = false;
            render_selection();
        }
    } else if (code == LV_EVENT_RELEASED) {
        if (!s_touch_down) return;
        s_touch_down = false;
        lv_coord_t dy = (lv_coord_t)(pt.y - s_touch_y0);
        // Only fires away from the very top status-bar strip — that stays
        // systemui's own drag zone (see this file's header comment).
        if (dy >= SWIPE_MIN_PX && s_touch_y0 > PURR_SYSTEMUI_STATUS_H + 4) {
            s_swiping = true;
            open_quick_settings();
        }
    }
}

static void attach_touch_handlers(lv_obj_t *obj)
{
    lv_obj_add_event_cb(obj, sb_touch_cb, LV_EVENT_PRESSED,  NULL);
    lv_obj_add_event_cb(obj, sb_touch_cb, LV_EVENT_RELEASED, NULL);
}

// ── All-apps list ────────────────────────────────────────────────────────────
// Reached via the bottom bar's search button (matching Lumia's own gesture:
// swipe/tap into an alphabetical all-apps list — search.png). Plain vertical
// list, one row per app_manager entry: small icon + name. Built lazily on
// first open, hidden (not destroyed) after — same "hide, not destroy"
// lifetime every other lazily-built screen in this codebase uses.

static void apps_row_cb(lv_event_t *e)
{
    int idx = (int)(intptr_t)lv_event_get_user_data(e);
    hide_apps_screen();
    launch_app(idx);
}

static void build_apps_screen(uint16_t w, uint16_t h)
{
    s_apps_screen = lv_obj_create(lv_scr_act());
    lv_obj_remove_style_all(s_apps_screen);
    lv_obj_set_size(s_apps_screen, w, (lv_coord_t)(h - BOTTOM_BAR_H));
    lv_obj_set_pos(s_apps_screen, 0, 0);
    lv_obj_set_style_bg_color(s_apps_screen, COL_BG, 0);
    lv_obj_set_style_bg_opa(s_apps_screen, LV_OPA_COVER, 0);
    lv_obj_set_style_pad_top(s_apps_screen, (lv_coord_t)(PURR_SYSTEMUI_STATUS_H + 8), 0);
    lv_obj_set_flex_flow(s_apps_screen, LV_FLEX_FLOW_COLUMN);
    lv_obj_set_style_pad_row(s_apps_screen, 10, 0);
    lv_obj_set_style_pad_left(s_apps_screen, 12, 0);
    lv_obj_add_flag(s_apps_screen, LV_OBJ_FLAG_HIDDEN);

    int n = app_manager_count();
    if (n > MAX_TILES) n = MAX_TILES;
    for (int i = 0; i < n; i++) {
        const app_entry_t *app = app_manager_get(i);
        if (!app) continue;

        lv_obj_t *row = lv_obj_create(s_apps_screen);
        lv_obj_remove_style_all(row);
        lv_obj_set_width(row, LV_PCT(100));
        lv_obj_set_height(row, 40);
        lv_obj_set_layout(row, LV_LAYOUT_FLEX);
        lv_obj_set_flex_flow(row, LV_FLEX_FLOW_ROW);
        lv_obj_set_flex_align(row, LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);
        lv_obj_set_style_pad_column(row, 12, 0);
        lv_obj_clear_flag(row, LV_OBJ_FLAG_SCROLLABLE);
        lv_obj_add_flag(row, LV_OBJ_FLAG_CLICKABLE);
        lv_obj_add_event_cb(row, apps_row_cb, LV_EVENT_CLICKED, (void *)(intptr_t)i);

        lv_obj_t *icon_bg = lv_obj_create(row);
        lv_obj_remove_style_all(icon_bg);
        lv_obj_set_size(icon_bg, 32, 32);
        lv_obj_set_style_bg_color(icon_bg, mochi_color_for_app(app->name), 0);
        lv_obj_set_style_bg_opa(icon_bg, LV_OPA_COVER, 0);
        lv_obj_clear_flag(icon_bg, LV_OBJ_FLAG_SCROLLABLE | LV_OBJ_FLAG_CLICKABLE);
        lv_obj_t *glyph = lv_img_create(icon_bg);
        lv_img_set_src(glyph, mochi_icon_for_app(app->name));
        lv_img_set_zoom(glyph, (uint16_t)((20 * 256) / 48));
        lv_obj_set_style_img_recolor(glyph, lv_color_white(), 0);
        lv_obj_set_style_img_recolor_opa(glyph, LV_OPA_COVER, 0);
        lv_obj_center(glyph);
        lv_obj_clear_flag(glyph, LV_OBJ_FLAG_CLICKABLE);

        lv_obj_t *lbl = lv_label_create(row);
        lv_label_set_text(lbl, app->name);
        lv_obj_set_style_text_color(lbl, COL_LABEL, 0);
        lv_obj_set_style_text_font(lbl, &lv_font_montserrat_14, 0);
        lv_obj_clear_flag(lbl, LV_OBJ_FLAG_CLICKABLE);
    }
}

static void show_apps_screen(void)
{
    if (!s_apps_screen) return;
    lv_obj_clear_flag(s_apps_screen, LV_OBJ_FLAG_HIDDEN);
    lv_obj_move_foreground(s_apps_screen);
    s_apps_screen_open = true;
}

static void hide_apps_screen(void)
{
    if (!s_apps_screen) return;
    lv_obj_add_flag(s_apps_screen, LV_OBJ_FLAG_HIDDEN);
    s_apps_screen_open = false;
}

// ── Quick settings ───────────────────────────────────────────────────────────
// Genuinely new — neither Mochi nor systemui has a quick-settings panel
// today. Scoped strictly to capabilities this device actually has; no
// fabricated toggles for radios/sensors it doesn't (matches this session's
// own standard, set while working on the meshtastic feature-flag stub —
// a real, linkable no-op is fine as infrastructure, a FAKE toggle presented
// as a real control is not).
static lv_obj_t *s_qs_panel;
static lv_obj_t *s_qs_brightness_slider;
static lv_obj_t *s_qs_notif_list;
static bool      s_qs_open = false;
// catcall_display_t has no get_brightness() — set_brightness() is the only
// direction this API goes (confirmed: catcall_display.h declares push_pixels/
// fill_rect/set_brightness/get_info/deinit, nothing else). Same "track the
// last value locally, there's no getter" pattern settings.c's own brightness
// slider already uses. 255 default matches that file's own default too.
static uint8_t s_qs_brightness = 255;

static void qs_brightness_cb(lv_event_t *e)
{
    lv_obj_t *slider = lv_event_get_target(e);
    int32_t v = lv_slider_get_value(slider);
    s_qs_brightness = (uint8_t)v;
    const catcall_display_t *disp = purr_kernel_display();
    if (disp && disp->set_brightness) disp->set_brightness(s_qs_brightness);
}

static void qs_close_cb(lv_event_t *e)
{
    (void)e;
    if (!s_qs_panel) return;
    lv_obj_add_flag(s_qs_panel, LV_OBJ_FLAG_HIDDEN);
    s_qs_open = false;
}

// See its own call site's comment: stops a tap on an interactive child
// (the brightness slider) from also bubbling up into qs_close_cb() on the
// panel itself, which would dismiss the panel out from under the tap.
static void qs_stop_bubble_cb(lv_event_t *e)
{
    lv_event_stop_bubbling(e);
}

static void qs_refresh_notifications(void)
{
    if (!s_qs_notif_list) return;
    lv_obj_clean(s_qs_notif_list);
    int n = purr_kernel_notify_count();
    if (n == 0) {
        lv_obj_t *empty = lv_label_create(s_qs_notif_list);
        lv_label_set_text(empty, "No notifications");
        lv_obj_set_style_text_color(empty, COL_LABEL_2, 0);
        return;
    }
    for (int i = 0; i < n; i++) {
        purr_notification_t note;
        if (!purr_kernel_notify_at(i, &note)) continue;
        lv_obj_t *row = lv_label_create(s_qs_notif_list);
        // title[32] + ": " + body[64] + '\0' = 99 worst case — sized above
        // that so GCC's -Werror=format-truncation can prove it never
        // truncates, not just "probably fits".
        char buf[112];
        snprintf(buf, sizeof(buf), "%s: %s", note.title[0] ? note.title : note.source, note.body);
        lv_label_set_text(row, buf);
        lv_label_set_long_mode(row, LV_LABEL_LONG_DOT);
        lv_obj_set_width(row, LV_PCT(100));
        lv_obj_set_style_text_color(row, COL_LABEL, 0);
        lv_obj_set_style_text_font(row, &lv_font_montserrat_14, 0);
    }
}

static void build_quick_settings(uint16_t w, uint16_t h)
{
    s_qs_panel = lv_obj_create(lv_scr_act());
    lv_obj_remove_style_all(s_qs_panel);
    lv_obj_set_size(s_qs_panel, w, h);
    lv_obj_set_pos(s_qs_panel, 0, 0);
    lv_obj_set_style_bg_color(s_qs_panel, COL_BG, 0);
    lv_obj_set_style_bg_opa(s_qs_panel, LV_OPA_COVER, 0);
    lv_obj_clear_flag(s_qs_panel, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_add_flag(s_qs_panel, LV_OBJ_FLAG_CLICKABLE);
    lv_obj_add_flag(s_qs_panel, LV_OBJ_FLAG_HIDDEN);
    // Tap anywhere below the controls to dismiss — same "tap outside to
    // close" convention the rest of this codebase's overlays use.
    lv_obj_add_event_cb(s_qs_panel, qs_close_cb, LV_EVENT_CLICKED, NULL);

    lv_obj_t *title = lv_label_create(s_qs_panel);
    lv_label_set_text(title, "Quick settings");
    lv_obj_set_style_text_color(title, COL_LABEL, 0);
    lv_obj_set_style_text_font(title, &lv_font_montserrat_14, 0);
    lv_obj_set_pos(title, 12, (lv_coord_t)(PURR_SYSTEMUI_STATUS_H + 8));
    lv_obj_clear_flag(title, LV_OBJ_FLAG_CLICKABLE);

    lv_obj_t *bright_lbl = lv_label_create(s_qs_panel);
    lv_label_set_text(bright_lbl, "Brightness");
    lv_obj_set_style_text_color(bright_lbl, COL_LABEL_2, 0);
    lv_obj_set_pos(bright_lbl, 12, (lv_coord_t)(PURR_SYSTEMUI_STATUS_H + 34));
    lv_obj_clear_flag(bright_lbl, LV_OBJ_FLAG_CLICKABLE);

    s_qs_brightness_slider = lv_slider_create(s_qs_panel);
    lv_obj_set_size(s_qs_brightness_slider, (lv_coord_t)(w - 24), 12);
    lv_obj_set_pos(s_qs_brightness_slider, 12, (lv_coord_t)(PURR_SYSTEMUI_STATUS_H + 54));
    lv_slider_set_range(s_qs_brightness_slider, 10, 255);
    lv_obj_set_style_bg_color(s_qs_brightness_slider, COL_TOGGLE_OFF, LV_PART_MAIN);
    lv_obj_set_style_bg_color(s_qs_brightness_slider, COL_TOGGLE_ON, LV_PART_INDICATOR);
    lv_obj_set_style_bg_color(s_qs_brightness_slider, lv_color_white(), LV_PART_KNOB);
    lv_obj_add_event_cb(s_qs_brightness_slider, qs_brightness_cb, LV_EVENT_VALUE_CHANGED, NULL);
    // Stop the panel's own dismiss-on-tap (qs_close_cb, on the panel itself)
    // from also firing when the slider is what actually got tapped — LVGL
    // events bubble from child to parent by default.
    lv_obj_add_event_cb(s_qs_brightness_slider, qs_stop_bubble_cb, LV_EVENT_CLICKED, NULL);

    lv_obj_t *notif_title = lv_label_create(s_qs_panel);
    lv_label_set_text(notif_title, "Notifications");
    lv_obj_set_style_text_color(notif_title, COL_LABEL_2, 0);
    lv_obj_set_pos(notif_title, 12, (lv_coord_t)(PURR_SYSTEMUI_STATUS_H + 84));
    lv_obj_clear_flag(notif_title, LV_OBJ_FLAG_CLICKABLE);

    s_qs_notif_list = lv_obj_create(s_qs_panel);
    lv_obj_remove_style_all(s_qs_notif_list);
    lv_obj_set_size(s_qs_notif_list, (lv_coord_t)(w - 24), (lv_coord_t)(h - PURR_SYSTEMUI_STATUS_H - 110));
    lv_obj_set_pos(s_qs_notif_list, 12, (lv_coord_t)(PURR_SYSTEMUI_STATUS_H + 104));
    lv_obj_set_flex_flow(s_qs_notif_list, LV_FLEX_FLOW_COLUMN);
    lv_obj_set_style_pad_row(s_qs_notif_list, 6, 0);
    lv_obj_set_scroll_dir(s_qs_notif_list, LV_DIR_VER);
    lv_obj_clear_flag(s_qs_notif_list, LV_OBJ_FLAG_CLICKABLE);
}

static void open_quick_settings(void)
{
    if (!s_qs_panel) return;
    if (s_qs_brightness_slider) {
        lv_slider_set_value(s_qs_brightness_slider, s_qs_brightness, LV_ANIM_OFF);
    }
    qs_refresh_notifications();
    lv_obj_clear_flag(s_qs_panel, LV_OBJ_FLAG_HIDDEN);
    lv_obj_move_foreground(s_qs_panel);
    s_qs_open = true;
}

// ── Hosting the system UI ───────────────────────────────────────────────────

static lv_color_t mochi_tint_color(const char *name, uint8_t base)
{
    (void)base;
    return mochi_color_for_app(name);
}

// No app-drawer overlay in a springboard — "hide the drawer" here means
// close whichever of the two overlay screens (apps list / quick settings)
// is open, so systemui asking for the drawer to go away actually clears the
// visible state instead of doing nothing.
static void mochi_hide_drawer(void)
{
    if (s_apps_screen_open) hide_apps_screen();
    if (s_qs_open) qs_close_cb(NULL);
}

static const purr_systemui_host_t s_systemui_host = {
    .width                   = mochi_hal_width,
    .height                  = mochi_hal_height,
    .icon_for_app            = mochi_icon_for_app,
    .tint_color              = mochi_tint_color,
    .hide_drawer             = mochi_hide_drawer,
    .hide_foreground_windows = mochi_win_hide_foreground,
    .last_activity_ms        = mochi_hal_last_activity_ms,
    .wallpaper               = mochi_wallpaper,
    // Lumia draws its own bottom bar (back/home/search) — same reasoning
    // the old iOS home indicator suppressed systemui's nav bar for.
    .suppress_navbar         = true,
    .group                   = mochi_hal_group,
};

// ── Public API ──────────────────────────────────────────────────────────────

void mochi_springboard_go_home(void)
{
    if (!s_screen) return;
    if (s_apps_screen_open) hide_apps_screen();
    if (s_qs_open) qs_close_cb(NULL);
    lv_obj_move_foreground(s_screen);
    purr_systemui_return_home();

    lv_group_t *g = mochi_hal_group();
    if (g) lv_group_focus_obj(s_screen);
}

void mochi_springboard_init(void)
{
    uint16_t w = mochi_hal_width();
    uint16_t h = mochi_hal_height();
    compute_metrics(w, h);

    s_screen = lv_obj_create(lv_scr_act());
    lv_obj_remove_style_all(s_screen);
    lv_obj_set_size(s_screen, w, h);
    lv_obj_set_pos(s_screen, 0, 0);
    lv_obj_set_style_bg_color(s_screen, COL_BG, 0);
    lv_obj_set_style_bg_opa(s_screen, LV_OPA_COVER, 0);
    lv_obj_clear_flag(s_screen, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_add_flag(s_screen, LV_OBJ_FLAG_CLICKABLE);
    lv_obj_add_event_cb(s_screen, sb_key_cb, LV_EVENT_KEY, NULL);

    s_tile_scroll = lv_obj_create(s_screen);
    lv_obj_remove_style_all(s_tile_scroll);
    lv_obj_set_size(s_tile_scroll, w, (lv_coord_t)(s_grid_bottom - s_grid_y));
    lv_obj_set_pos(s_tile_scroll, 0, s_grid_y);
    lv_obj_set_scroll_dir(s_tile_scroll, LV_DIR_VER);
    lv_obj_clear_flag(s_tile_scroll, LV_OBJ_FLAG_CLICKABLE);
    attach_touch_handlers(s_tile_scroll);
    attach_touch_handlers(s_screen);

    lv_group_t *g = mochi_hal_group();
    if (g) lv_group_add_obj(g, s_screen);

    // Status bar, drag-down panels, Recents and lock screen — must run
    // BEFORE the tile grid is first built, same real "0 apps flash on
    // boot" fix this file's previous version already found and documented
    // (purr_systemui_init() is what fires the no-password auto-login path
    // that unlocks app_manager's registry — see systemui_login_ios.c).
    purr_systemui_init(&s_systemui_host);

    compute_layout();
    render_tiles();

    build_bottom_bar(w, h);
    build_apps_screen(w, h);
    build_quick_settings(w, h);

    mochi_springboard_go_home();

    ESP_LOGI(TAG, "Lumia springboard built (%ux%u, %d tiles)", w, h, s_tile_count);
}

void mochi_springboard_tick(void)
{
    purr_systemui_tick();

    static int s_last_app_count = -1;
    int n = app_manager_count();
    if (n != s_last_app_count) {
        s_last_app_count = n;
        compute_layout();
        render_tiles();
    }
}
