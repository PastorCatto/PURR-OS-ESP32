# devices/tab5/device.pcat
# M5Stack Tab5 — ESP32-P4, 5" 720x1280 MIPI-DSI (ST7123 display+touch), attachable
# I2C keyboard, 32MB PSRAM. Used landscape (1280x720) — the st7123 driver rotates.
#
# Radio is OFF for DP1: WiFi/BT live on an ESP32-C6 co-processor behind esp-hosted
# (SDIO), which nothing in the tree brings up yet, and ESP-NOW does not exist on
# the P4 at all (disabled in IDF) — so proximity/pairing can never run here. When
# esp-hosted lands, set wifi = true AND radio_companion = false together.
#
# Requires ESP-IDF 5.5.4 (esp32p4 target + esp_lcd_dpi/PPA) — other devices stay
# on the pinned 5.3.5; point IDF_PATH at the 5.5.4 install to build this one.

[device]
name        = "tab5"
chip        = "esp32p4"
kernel_type = "native"
flash_mb    = 16
psram       = true
psram_mb    = 32
# 2496 KB = 0x270000, the exact spiffs partition length in partitions_16mb.csv.
# A smaller image (the 1024 the other 16MB devices use) fails to mount on this
# device with SPIFFS -10025: the filesystem geometry baked by spiffsgen must
# match the partition size esp_spiffs mounts with.
spiffs_kb      = 2496
spiffs_offset  = "0xD90000"

[drivers]
display     = "st7123"
touch       = "st7123"
# tab5_kbd sits in the input slot (not keyboard=) — purrstrap's glue generator
# only emits static registration for display/touch/input/radio/gps/battery;
# a keyboard= entry would silently never be registered on a native kernel.
input       = "tab5_kbd"
radio       = ""
gps         = ""

[radio]
wifi        = false
bt          = false
lora        = ""

[modules]
# mochi — iOS-style springboard (LVGL 8), the backend the upstream author
# is actively building on for his own hardware (tdeck_plus). This branch
# tracks bringing it up on the Tab5's 640x360 landscape surface.
#
# The springboard grid derives from panel size (DP8 fixed the old hardcoded
# 4x2), so the wide P4 panel lays out as 8x3. Mochi detects keyboard-vs-
# trackball by capability (a keyboard-class driver implements set_backlight;
# tab5_kbd does), so it registers tab5_kbd as its keypad indev and skips the
# absent trackball with no error — confirmed live: "inputs: keyboard=tab5_kbd
# trackball=none".
#
# Requires the two generic-kernel fixes earlier on this branch (crash-guard
# strike reset in core/boot.c, NULL-scan guard in app_manager) — without them
# a single app_manager strike latched the device into a permanent crash loop
# that no reflash could clear. Cupcake masked this because its own launcher
# tolerated app_manager coming up empty; Mochi's springboard surfaced it.
ui          = "mochi"
app_manager = "app_manager"
lua         = "lua_runtime"
# systemui — Mochi hosts it (iOS-style status bar, drag-down panels, Recents,
# lock screen) and suppresses the nav bar in favour of a home-indicator
# gesture (purr_systemui_host_t::suppress_navbar). Declaring it in mochi's
# module.pcat [depends] only makes the code link; CONFIG_PURR_SYSTEMUI is set
# from THIS entry independently — same trap Cupcake hit (see PR #4).
systemui    = "systemui"

[ui]
# systemui_style — Mochi draws no nav bar (home-indicator gesture, like real
# iOS); "ios" is the correct pairing. "android" is Cupcake's nav-bar style.
systemui_style = "ios"
theme       = "wce"

[apps]
settings    = true
terminal    = true
fileman     = true
# Merges what used to be hwtest/drivermgr/services/taskmgr — see
# source/apps/system/diagnostics/diagnostics.c's file header.
diagnostics = true

[flash]
display/st7123     = 1
touch/st7123       = 1
input/tab5_kbd     = 1
cupcake            = 2
app_manager        = 2
driver_manager     = 2
lua_runtime        = 2
apps/settings      = 3
apps/terminal      = 3
apps/fileman       = 3
apps/diagnostics   = 3

[pins]
# Documentation — the st7123/tab5_kbd drivers hard-code the Tab5's fixed wiring
# (repo convention: native drivers own their pin #defines).
display_bl    = 22

touch_sda     = 31
touch_scl     = 32
touch_int     = 23
touch_rst     = -1

kbd_sda       = 0
kbd_scl       = 1
kbd_int       = 50

sd_enabled    = false
