# devices/tdeck_plus/device.pcat
# T-Deck Plus — ESP32-S3, 3.2" ST7789, GT911 touch, trackball, LoRa SX1262, GPS
# Large screen. Full radio set (WiFi + BT built-in, LoRa SX1262, GPS). Base OS profile.

[device]
name        = "tdeck_plus"
chip        = "esp32s3"
kernel_type = "native"
flash_mb    = 16
port        = "/dev/ttyACM0"
psram       = true
psram_mb    = 8

spiffs_offset  = "0xD90000"

[drivers]
display     = "st7789"
touch       = "gt911"
input       = "trackball"
keyboard    = "bbq20"
radio       = "sx1262_rl"
gps         = "generic_nmea"
battery     = "adc_battery"

[radio]
wifi        = true
# bt — NimBLE (BLE-only, this chip has no classic BT). Needed for
# Meshtastic's phone-companion BLE service (mesh_ble.c). Live-crash history
# so far, each root-caused and fixed: two internal-DRAM exhaustion crashes
# (sdkconfig_tdeck_plus.overrides's Bluetooth section), a cupcake_task
# watchdog trip from a blocking scan call on the UI task (settings.c's
# bt_scan_task fix), and a mesh_ble.c crash calling ble_gatts_chr_updated()
# on a not-yet-registered handle before BT was ever turned on (fixed —
# gated on bt_mgr_host_ready()). Internal free RAM still runs tight (~62KB
# -> ~26KB just from activating) — worth watching, not yet proven safe
# under sustained mesh traffic + BLE together.
bt          = true
# sx1262_rl — RadioLib-backed driver (source/drivers/radio/sx1262_rl),
# swapped in for real Meshtastic node discovery instead of the hand-rolled
# sx1262.c SPI driver (still present, unused by this device — see the
# "Vendor Meshtastic's real radio/crypto code" plan).
lora        = "sx1262_rl"

# Presentation choices that select between implementations rather than naming
# a module to register. Deliberately NOT in [modules]: purrstrap turns every
# modules.* value into a static module registration, so a style name there
# would emit a reference to a module that doesn't exist.
[ui]
# systemui_style — "android" (nav bar, text-row notification panels) or "ios"
# (no nav bar, card notifications shared between the shade and the lock
# screen). Pairs with the Mochi springboard below.
systemui_style = "ios"

[modules]
# ui — back to Cupcake. The MiniWin WinCE desktop was selected here for the
# 4-window-split pass (commit 9ef61b97), but that rewrite is broken on
# hardware and hasn't been fixed yet, so this device stays off it rather
# than shipping a known-bad desktop. MiniWin's code is still compiled and
# selectable — only this device's default moved back.
# ui — Mochi: iOS-style springboard (squircle icon grid, dock, home indicator),
# with trackball/arrow-key cursor navigation layered on top so it isn't
# touch-only on a device that has better inputs than touch. Cupcake and Tabby
# both still build; this is a one-word revert either way.
ui          = "mochi"
# systemui — the status bar, drag-down panels, Back/Home/Recents nav bar,
# Recents carousel and lock screen, split out of Cupcake into their own
# module (source/modules/systemui/). Cupcake hosts it; this entry is what
# both statically registers it and sets CONFIG_PURR_SYSTEMUI. Drop this line
# and Cupcake still boots as a bare launcher with no chrome.
systemui    = "systemui"
app_manager = "app_manager"
# mesh — re-enabled for active Meshtastic diagnosis (was off, gated behind
# CONFIG_PURR_FEATURE_MESHTASTIC, see CoreOS/main/Kconfig.projbuild).
mesh        = "meshtastic"
# meshcore — compiled in and statically registered alongside meshtastic
# (separate [modules] key, both loaded into the static registry — see
# purrstrap.py's free-form modules.* handling), but NOT the boot-time
# default: meshtastic loads first and meshcore's own mutual-exclusion
# guard (meshcore_module.cpp) refuses to activate while it's running.
# Manually toggle via Terminal's `stop meshtastic` / `start meshcore`
# until roadmap item 2 (the NVS-driven select-and-reboot switch) exists.
meshcore    = "meshcore"
lua         = "lua_runtime"
wifi        = "wifi_mgr"
bt          = "bt_mgr"
# proximity/pairing — NOT listed here anymore; purrstrap.py's
# apply_radio_companion_defaults() adds them automatically to any device
# with [radio] wifi = true (this one), see cyd/device.pcat's comment for
# the full heuristic. msn/nearby above predate that mechanism (added
# during the earlier MSN rewrite) and stay explicit.

[ui]
theme       = "wce"

[apps]
settings    = true
terminal    = true
fileman     = true
hwtest      = true
drivermgr   = true
msn         = true
services    = true
taskmgr     = true
nearby      = true

[flash]
display/st7789    = 1
touch/gt911       = 1
input/trackball   = 1
cardstack         = 2
app_manager       = 2
radio/sx1262_rl   = 2
driver_manager    = 2
wifi_mgr          = 2
bt_mgr            = 2
lua_runtime       = 2
meshtastic        = 2
meshcore          = 2
gps/generic_nmea  = 3
battery/adc_battery = 3
apps/settings     = 3
apps/terminal     = 3
apps/fileman      = 3
apps/hwtest       = 3
apps/drivermgr    = 3
apps/msn          = 3
apps/services     = 3
apps/taskmgr      = 3
apps/nearby       = 3

[pins]
display_cs    = 12
display_dc    = 11
display_mosi  = 41
display_sclk  = 40
display_rst   = -1
display_bl    = 42

touch_sda     = 18
touch_scl     = 8
touch_int     = 16
touch_rst     = -1

trackball_up   = 3
trackball_down = 15
trackball_left = 1
trackball_right= 2
trackball_click= 0

# LoRa shares the same SPI2_HOST bus as display/SD below (confirmed against
# LilyGo's own utilities.h/TDECK_PINS.h) — these were previously wrong
# (mosi/miso/sclk described a separate bus that doesn't exist on this board),
# left over from when this device incorrectly ran the sx1276 driver.
lora_mosi     = 41
lora_miso     = 38
lora_sclk     = 40
lora_cs       = 9
lora_rst      = 17
lora_busy     = 13
lora_irq      = 45

gps_tx        = 43
gps_rx        = 44

# adc_battery's fallback default already matches this (see its own
# comment) — listed here for documentation only.
battery_adc   = 4

# sd_cs was previously 13, which collided with the real LoRa BUSY pin above —
# corrected against LilyGo's TDECK_SDCARD_CS.
sd_cs         = 39
sd_mosi       = 41
sd_miso       = 38
sd_sclk       = 40
sd_enabled    = true
