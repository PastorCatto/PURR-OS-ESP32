# devices/cyd/device.pcat
# ESP32-2432S028 — CYD "Cheap Yellow Display", 2.8" ILI9341 + XPT2046 touch
# Medium screen (320×240). Base OS profile.

[device]
name        = "cyd"
chip        = "esp32"
kernel_type = "native"
flash_mb    = 4
psram       = false
spiffs_kb   = 512

[drivers]
display     = "ili9341"
touch       = "xpt2046"
input       = ""
radio       = ""
gps         = ""

[radio]
# ESP32 has built-in WiFi + BT — no LoRa module on base CYD.
# bt — off for now (stripped-down minimal profile, matches every non-T-Deck
# device): meshtastic/bt_mgr removed, WiFi kept. Also frees the DRAM budget
# taskmgr/terminal/fileman/etc. were eating into on this PSRAM-less board.
wifi        = true
bt          = false
lora        = ""

[modules]
# ui — console-only for the protected-processes/Unix-boot rewrite:
# MiniWin moved to archive/ui_backends_v1/ (see that folder's own
# README.md). "none" is an explicit flag (not a comment) — see
# purrstrap.py's UI_NO_STATIC_MODULE_VALUES — meaning loginUI
# (source/apps/system/login_ui/) ships its framebuffer renderer here.
# This was previously left as "miniwin" (a module that no longer exists
# in the live tree) — an out-of-scope, broken build until this flip;
# not hardware-verified this pass (compile-only, no CYD on the bench for
# this change specifically).
ui          = "none"
app_manager = "app_manager"
lua         = "lua_runtime"
wifi        = "wifi_mgr"
# proximity/pairing/msn/nearby are NOT listed here — purrstrap.py's
# apply_radio_companion_defaults() adds proximity/pairing automatically
# to any device with [radio] wifi = true regardless of ui; msn/nearby
# specifically need a purr_win-capable UI (PURR_WIN_UI_BACKENDS), which
# "none" no longer is — those two stay off until this device gets a real
# UI again. Set radio_companion = false here to opt out of even the
# radio-only modules if that's ever undesirable.

[ui]
theme       = "wce"

[apps]
# Stripped-down minimal profile — terminal/fileman/taskmgr/calculator still
# dropped (PSRAM-less, tightly DRAM-budgeted board, see the [radio] comment
# above). msn no longer auto-adds either, now that ui = "none" isn't a
# purr_win-capable backend (see [modules]'s comment).
# settings/diagnostics — DESELECTED alongside the ui flip above: both call
# purr_win_* directly (settings.c's own CMakeLists.txt hardcodes REQUIRES
# miniwin/cupcake/systemui — a real link failure with those archived;
# diagnostics.c compiles clean but has nothing to render through either),
# same "console-only, no UI to run against" reasoning tdeck_plus/tdeck/tab5
# already applied to these two apps.
#settings    = true
#diagnostics = true

[flash]
# Priority 1 — required, kernel panics without these
display/ili9341  = 1
touch/xpt2046    = 1
# Priority 2 — important UI + management layer
miniwin          = 2
app_manager      = 2
driver_manager   = 2
wifi_mgr         = 2
lua_runtime      = 2
# Priority 3 — base OS apps
apps/settings    = 3
apps/diagnostics = 3

[pins]
display_cs    = 15
display_dc    = 2
display_mosi  = 13
display_sclk  = 14
display_rst   = -1
display_bl    = 21

touch_cs      = 33
touch_miso    = 12
touch_mosi    = 13
touch_sclk    = 14
touch_irq     = 36

sd_cs         = 5
sd_mosi       = 23
sd_miso       = 19
sd_sclk       = 18
sd_enabled    = true
